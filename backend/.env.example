# ═══════════════════════════════════════════════════════════════════
# InvoiceMate Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ═══════════════════════════════════════════════════════════════════

# ─── APP ─────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000

# ─── DATABASE (PostgreSQL) ────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=invoicemate
DB_PASSWORD=your_secure_password_here
DB_NAME=invoicemate_db

# ─── REDIS ───────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── JWT ─────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_very_long_random_secret_min_64_chars
JWT_EXPIRY=15m
JWT_REFRESH_SECRET=change_this_to_a_different_long_random_secret
JWT_REFRESH_EXPIRY=30d

# ─── OPENAI ──────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ─── PINECONE (Vector DB) ─────────────────────────────────────────
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_INDEX=invoicemate-embeddings
PINECONE_ENVIRONMENT=us-east-1-aws

# ─── AWS ─────────────────────────────────────────────────────────
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
S3_BUCKET=invoicemate-pdfs

# ─── TWILIO (WhatsApp) ────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_WHATSAPP_NUMBER=+14155238886

# ─── SENDGRID (Email) ─────────────────────────────────────────────
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxx
SENDGRID_FROM_EMAIL=noreply@invoicemate.lk
SENDGRID_FROM_NAME=InvoiceMate

# ─── GOOGLE OAUTH (optional) ──────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/v1/auth/google/callback
